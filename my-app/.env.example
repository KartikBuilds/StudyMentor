# Environment variables for the React app (Vite uses VITE_ prefix)
# Copy this file to .env and fill in real values. Never commit .env.

VITE_API_BASE_URL=http://localhost:8000

# Optional: opt into offline/no-backend demo mode (mock auth, sample data,
# no real AI calls). Off by default - real backend auth/AI is used.
VITE_DEMO_MODE=false

# There is intentionally no client-side Gemini/AI API key variable here.
# All AI calls (study buddy chat, syllabus analysis, study plan/flashcard/
# quiz generation) are routed through the backend, which holds the real
# GOOGLE_API_KEY/GROQ_API_KEY server-side. Never add a VITE_-prefixed
# Gemini/Groq key - any VITE_ variable is bundled into the browser build
# and becomes publicly visible.
