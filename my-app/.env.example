# Environment variables for the React app (Vite uses VITE_ prefix)
# Copy this file to .env and fill in real values. Never commit .env.

VITE_API_BASE_URL=http://localhost:8000

# Only needed if the frontend calls Gemini directly (not recommended for
# production - prefer routing AI calls through the backend so the key
# never reaches the browser bundle).
VITE_GEMINI_API_KEY=
